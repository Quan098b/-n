<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:endColor="#D7CCC8"
                android:startColor="#FFF3E0" />
        </shape>
    </item>
    <item android:left="24dp" android:top="24dp" android:right="24dp" android:bottom="24dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#F87171" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
